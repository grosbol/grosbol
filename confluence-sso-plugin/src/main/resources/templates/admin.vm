## SSO Plugin Admin Configuration Page
## Velocity template rendered by SSOAdminServlet
#set($req = $webResourceManager)

<html>
<head>
    <title>SSO Plugin Configuration</title>
    $webResourceManager.requireResourcesForContext("sso-admin")
</head>
<body>

<div id="sso-admin-wrapper" class="aui-page-panel">
    <div class="aui-page-panel-inner">

        <section class="aui-page-panel-content">
            <h1>Single Sign-On (SSO) Configuration</h1>

            #if($message)
                <div class="aui-message #if($message.contains('Error'))aui-message-error#else aui-message-success#end">
                    <span class="aui-icon"></span>
                    $message
                </div>
            #end

            <form action="$baseUrl" method="POST" id="sso-admin-form">

                <!-- ── General ──────────────────────────────────────── -->
                <fieldset>
                    <legend>General Settings</legend>

                    <div class="field-group">
                        <label for="enabled">Enable SSO</label>
                        <input type="checkbox" id="enabled" name="enabled"
                               value="true" #if($config.enabled) checked #end />
                        <div class="description">Enable or disable the SSO plugin globally.</div>
                    </div>

                    <div class="field-group">
                        <label for="forceSSO">Force SSO</label>
                        <input type="checkbox" id="forceSSO" name="forceSSO"
                               value="true" #if($config.forceSSO) checked #end />
                        <div class="description">
                            Redirect all unauthenticated users to the IdP login page.
                            When disabled, users can still use Confluence's own login form.
                        </div>
                    </div>

                    <div class="field-group">
                        <label for="protocol">Protocol</label>
                        <select id="protocol" name="protocol" class="select">
                            <option value="SAML"
                                #if($config.protocol.name() == "SAML") selected #end>SAML 2.0</option>
                            <option value="OIDC"
                                #if($config.protocol.name() == "OIDC") selected #end>OpenID Connect / OAuth 2.0</option>
                        </select>
                    </div>

                    <div class="field-group">
                        <label for="defaultRedirectPath">Default Redirect Path</label>
                        <input type="text" id="defaultRedirectPath" name="defaultRedirectPath"
                               class="text" value="$!config.defaultRedirectPath" />
                        <div class="description">Where to send users after a successful login (default: /).</div>
                    </div>
                </fieldset>

                <!-- ── SAML ─────────────────────────────────────────── -->
                <fieldset id="saml-section">
                    <legend>SAML 2.0 Settings</legend>

                    <h3>Identity Provider (IdP)</h3>

                    <div class="field-group">
                        <label for="samlIdpEntityId">IdP Entity ID</label>
                        <input type="text" id="samlIdpEntityId" name="samlIdpEntityId"
                               class="text long-field" value="$!config.samlIdpEntityId" />
                    </div>
                    <div class="field-group">
                        <label for="samlIdpSsoUrl">IdP SSO URL</label>
                        <input type="url" id="samlIdpSsoUrl" name="samlIdpSsoUrl"
                               class="text long-field" value="$!config.samlIdpSsoUrl" />
                    </div>
                    <div class="field-group">
                        <label for="samlIdpSloUrl">IdP SLO URL (optional)</label>
                        <input type="url" id="samlIdpSloUrl" name="samlIdpSloUrl"
                               class="text long-field" value="$!config.samlIdpSloUrl" />
                    </div>
                    <div class="field-group">
                        <label for="samlIdpCertificate">IdP X.509 Certificate (PEM)</label>
                        <textarea id="samlIdpCertificate" name="samlIdpCertificate"
                                  class="textarea" rows="6">$!config.samlIdpCertificate</textarea>
                        <div class="description">Paste the full PEM certificate including BEGIN/END lines.</div>
                    </div>

                    <h3>Service Provider (SP — this Confluence instance)</h3>

                    <div class="field-group">
                        <label for="samlSpEntityId">SP Entity ID</label>
                        <input type="text" id="samlSpEntityId" name="samlSpEntityId"
                               class="text long-field" value="$!config.samlSpEntityId" />
                        <div class="description">Usually your Confluence base URL, e.g. https://confluence.example.com</div>
                    </div>
                    <div class="field-group">
                        <label for="samlSpAcsUrl">ACS URL</label>
                        <input type="url" id="samlSpAcsUrl" name="samlSpAcsUrl"
                               class="text long-field" value="$!config.samlSpAcsUrl" />
                        <div class="description">e.g. https://confluence.example.com/plugins/servlet/sso/saml/acs</div>
                    </div>
                    <div class="field-group">
                        <label for="samlSpSloUrl">SP SLO URL (optional)</label>
                        <input type="url" id="samlSpSloUrl" name="samlSpSloUrl"
                               class="text long-field" value="$!config.samlSpSloUrl" />
                    </div>
                    <div class="field-group">
                        <label for="samlSpPrivateKey">SP Private Key (PEM)</label>
                        <textarea id="samlSpPrivateKey" name="samlSpPrivateKey"
                                  class="textarea" rows="6">$!config.samlSpPrivateKey</textarea>
                        <div class="description">Required when signing AuthnRequests.</div>
                    </div>
                    <div class="field-group">
                        <label for="samlSpCertificate">SP Certificate (PEM)</label>
                        <textarea id="samlSpCertificate" name="samlSpCertificate"
                                  class="textarea" rows="6">$!config.samlSpCertificate</textarea>
                    </div>
                    <div class="field-group">
                        <label for="samlSignRequests">Sign AuthnRequests</label>
                        <input type="checkbox" id="samlSignRequests" name="samlSignRequests"
                               value="true" #if($config.samlSignRequests) checked #end />
                    </div>
                    <div class="field-group">
                        <label for="samlWantAssertionsSigned">Require Signed Assertions</label>
                        <input type="checkbox" id="samlWantAssertionsSigned" name="samlWantAssertionsSigned"
                               value="true" #if($config.samlWantAssertionsSigned) checked #end />
                    </div>

                    <h3>Attribute Mapping</h3>
                    <div class="field-group">
                        <label for="samlAttributeEmail">Email Attribute</label>
                        <input type="text" id="samlAttributeEmail" name="samlAttributeEmail"
                               class="text" value="$!config.samlAttributeEmail" />
                    </div>
                    <div class="field-group">
                        <label for="samlAttributeFullName">Full Name Attribute</label>
                        <input type="text" id="samlAttributeFullName" name="samlAttributeFullName"
                               class="text" value="$!config.samlAttributeFullName" />
                    </div>
                    <div class="field-group">
                        <label for="samlAttributeGroups">Groups Attribute</label>
                        <input type="text" id="samlAttributeGroups" name="samlAttributeGroups"
                               class="text" value="$!config.samlAttributeGroups" />
                    </div>

                    <div class="field-group">
                        <a href="/plugins/servlet/sso/saml/metadata" target="_blank" class="aui-button">
                            Download SP Metadata XML
                        </a>
                    </div>
                </fieldset>

                <!-- ── OIDC ─────────────────────────────────────────── -->
                <fieldset id="oidc-section">
                    <legend>OpenID Connect / OAuth 2.0 Settings</legend>

                    <div class="field-group">
                        <label for="oidcIssuerUrl">Issuer URL</label>
                        <input type="url" id="oidcIssuerUrl" name="oidcIssuerUrl"
                               class="text long-field" value="$!config.oidcIssuerUrl" />
                        <div class="description">e.g. https://accounts.google.com or https://your-tenant.okta.com</div>
                    </div>
                    <div class="field-group">
                        <label for="oidcClientId">Client ID</label>
                        <input type="text" id="oidcClientId" name="oidcClientId"
                               class="text" value="$!config.oidcClientId" />
                    </div>
                    <div class="field-group">
                        <label for="oidcClientSecret">Client Secret</label>
                        <input type="password" id="oidcClientSecret" name="oidcClientSecret"
                               class="text" value="$!config.oidcClientSecret" />
                    </div>
                    <div class="field-group">
                        <label for="oidcRedirectUri">Redirect URI</label>
                        <input type="url" id="oidcRedirectUri" name="oidcRedirectUri"
                               class="text long-field" value="$!config.oidcRedirectUri" />
                        <div class="description">e.g. https://confluence.example.com/plugins/servlet/sso/oidc/callback</div>
                    </div>
                    <div class="field-group">
                        <label for="oidcScopes">Scopes</label>
                        <input type="text" id="oidcScopes" name="oidcScopes"
                               class="text" value="$!config.oidcScopes" />
                    </div>
                    <div class="field-group">
                        <label for="oidcPkceEnabled">Enable PKCE (S256)</label>
                        <input type="checkbox" id="oidcPkceEnabled" name="oidcPkceEnabled"
                               value="true" #if($config.oidcPkceEnabled) checked #end />
                        <div class="description">Recommended for public clients and modern IdPs.</div>
                    </div>

                    <h3>Claim Mapping</h3>
                    <div class="field-group">
                        <label for="oidcClaimEmail">Email Claim</label>
                        <input type="text" id="oidcClaimEmail" name="oidcClaimEmail"
                               class="text" value="$!config.oidcClaimEmail" />
                    </div>
                    <div class="field-group">
                        <label for="oidcClaimFullName">Full Name Claim</label>
                        <input type="text" id="oidcClaimFullName" name="oidcClaimFullName"
                               class="text" value="$!config.oidcClaimFullName" />
                    </div>
                    <div class="field-group">
                        <label for="oidcClaimGroups">Groups Claim</label>
                        <input type="text" id="oidcClaimGroups" name="oidcClaimGroups"
                               class="text" value="$!config.oidcClaimGroups" />
                    </div>
                </fieldset>

                <!-- ── User Provisioning ─────────────────────────────── -->
                <fieldset>
                    <legend>User Provisioning</legend>

                    <div class="field-group">
                        <label for="autoProvisionUsers">Auto-provision New Users</label>
                        <input type="checkbox" id="autoProvisionUsers" name="autoProvisionUsers"
                               value="true" #if($config.autoProvisionUsers) checked #end />
                        <div class="description">
                            Create a Confluence account for first-time SSO logins.
                            If disabled, users must exist in Confluence before they can log in via SSO.
                        </div>
                    </div>
                    <div class="field-group">
                        <label for="syncGroupMembership">Sync Group Membership</label>
                        <input type="checkbox" id="syncGroupMembership" name="syncGroupMembership"
                               value="true" #if($config.syncGroupMembership) checked #end />
                        <div class="description">Add users to Confluence groups matching their IdP group claims.</div>
                    </div>
                    <div class="field-group">
                        <label for="defaultGroup">Default Group</label>
                        <input type="text" id="defaultGroup" name="defaultGroup"
                               class="text" value="$!config.defaultGroup" />
                        <div class="description">Every SSO user is added to this group (e.g. confluence-users).</div>
                    </div>
                </fieldset>

                <div class="buttons-container">
                    <div class="buttons">
                        <input type="submit" class="aui-button aui-button-primary" value="Save Configuration" />
                    </div>
                </div>

            </form>
        </section>
    </div>
</div>

<script>
// Show/hide SAML or OIDC section based on protocol selection
(function () {
    var protocolSelect = document.getElementById('protocol');
    var samlSection    = document.getElementById('saml-section');
    var oidcSection    = document.getElementById('oidc-section');

    function toggle() {
        var p = protocolSelect.value;
        samlSection.style.display = (p === 'SAML') ? '' : 'none';
        oidcSection.style.display = (p === 'OIDC') ? '' : 'none';
    }

    protocolSelect.addEventListener('change', toggle);
    toggle();

    // Convert checkboxes to proper boolean values on submit
    document.getElementById('sso-admin-form').addEventListener('submit', function () {
        ['enabled','forceSSO','samlSignRequests','samlWantAssertionsSigned',
         'oidcPkceEnabled','autoProvisionUsers','syncGroupMembership'].forEach(function (id) {
            var el = document.getElementById(id);
            if (el) el.value = el.checked ? 'true' : 'false';
        });
    });
}());
</script>

</body>
</html>
